# Copiar como .env (NO subir .env al repositorio: está en .gitignore)

# --- Componente 4: API de Datos Abiertos Colombia (Socrata) ---
# Opcional: token de aplicación para subir el límite de peticiones.
# Se obtiene gratis en https://www.datos.gov.co/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# Rango de fechas por defecto (AAAA-MM-DD). Si FECHA_FIN se omite, se usa la fecha de hoy.
FECHA_INICIO=2023-01-01
# FECHA_FIN=2026-09-22

REQUEST_TIMEOUT=30
